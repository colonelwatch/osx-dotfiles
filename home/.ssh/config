Include ~/.ssh/config.d/*  # managed by backup and recovery

# amortize connection creation over the tailnet
Host *-tailscale
	ControlPath ~/.cache/ssh/%r@%h:%p
	ControlMaster auto
	ControlPersist 10m

Host *
	AddKeysToAgent yes  # if agent forwarding is enabled, add keys
	Compression yes
	SendEnv COLORTERM  # send terminal type, if it is accepted
